# Public demo defaults. Every value is a placeholder.
# This server reads process environment variables; it does not auto-load .env.
# Never commit a real key. The browser never receives these values.
ENABLE_LIVE_AI=0
LIVE_AI_BASE_URL=
LIVE_AI_API_KEY=
LIVE_AI_MODEL=

# Optional local server port. The default is 8137.
PORT=8137
